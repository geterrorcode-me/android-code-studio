<?xml version="1.0" encoding="utf-8"?>
<!-- chat-ux: satu bubble pesan; role menentukan sisi & warna -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/bubbleUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_bubble_user"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginStart="48dp">

        <TextView
            android:id="@+id/textUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bubbleAgent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_bubble_agent"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginEnd="48dp">

        <TextView
            android:id="@+id/textAgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textIsSelectable="true"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

</LinearLayout>
